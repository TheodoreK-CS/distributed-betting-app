<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="18dp">

    <ImageButton
        android:id="@+id/back_button_game"
        android:layout_width="54dp"
        android:layout_height="45dp"
        android:background="@drawable/rounded_button"
        android:onClick="click_back"
        android:padding="9dp"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/back" />

    <TextView
        android:id="@+id/gname"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:text="Game Name"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/grating"
        app:layout_constraintStart_toEndOf="@+id/back_button_game"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/grating"
        android:layout_width="82dp"
        android:layout_height="55dp"
        android:gravity="center"
        android:text="4.5★"
        android:textColor="@color/white"
        android:background="@color/black"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/gprovider"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:background="@color/silver"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:text="Provider:"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gname" />

    <TextView
        android:id="@+id/grisk"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@color/silver"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:text="Risk:"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gprovider" />

    <TextView
        android:id="@+id/gbet_category"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@color/silver"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:text="Bet Category:"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/grisk" />

    <TextView
        android:id="@+id/gmin_bet"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@color/silver"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:text="Min Bet:"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/gmax_bet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gbet_category" />

    <TextView
        android:id="@+id/gmax_bet"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:background="@color/silver"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:text="Max Bet:"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/gmin_bet"
        app:layout_constraintTop_toBottomOf="@+id/gbet_category" />

    <TextView
        android:id="@+id/gbalance"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="Balance: 0.00"
        android:background="@drawable/rounded_button"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gmin_bet" />

    <EditText
        android:id="@+id/bet_amount"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/rounded_field"
        android:hint="Bet amount"
        android:inputType="numberDecimal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="@color/black"
        android:textColorHint="@color/dark_gray"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gbalance" />

    <Button
        android:id="@+id/play_button"
        android:layout_width="190dp"
        android:layout_height="58dp"
        android:layout_marginTop="20dp"
        android:onClick="click_playBet"
        android:text="PLAY"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bet_amount" />

    <TextView
        android:id="@+id/gresult"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/rounded_card"
        android:backgroundTint="@color/casino_red"
        android:gravity="center"
        android:padding="14dp"
        android:text="After playing, tap the rating to review the game."
        android:textColor="@color/black"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/play_button" />

</androidx.constraintlayout.widget.ConstraintLayout>
