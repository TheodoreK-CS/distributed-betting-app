<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <TextView
        android:id="@+id/welcome_text"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Welcome PLAYER"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="30sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/balance_button"
        android:layout_width="165dp"
        android:layout_height="63dp"
        android:maxLines="2"
        android:onClick="click_balance"
        android:text="Balance"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/filter_button"
        app:layout_constraintHorizontal_bias="0.11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/welcome_text" />

    <ImageButton
        android:id="@+id/filter_button"
        android:layout_width="64dp"
        android:layout_height="63dp"
        android:background="@drawable/rounded_button"
        android:onClick="click_filters"
        android:padding="12dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toStartOf="@+id/refresh_button"
        app:layout_constraintTop_toBottomOf="@+id/welcome_text"
        app:srcCompat="@drawable/filters" />

    <ImageButton
        android:id="@+id/refresh_button"
        android:layout_width="64dp"
        android:layout_height="63dp"
        android:background="@drawable/rounded_button"
        android:onClick="click_refresh"
        android:padding="12dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.95"
        app:layout_constraintStart_toEndOf="@+id/filter_button"
        app:layout_constraintTop_toBottomOf="@+id/welcome_text"
        app:srcCompat="@drawable/refresh" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/game_recycle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/balance_button"
        tools:listitem="@layout/game_row" />

</androidx.constraintlayout.widget.ConstraintLayout>
